@article{deng_ZhonghuaErBiYanHouTouJingWaiKeZaZhi_2026,
  title = {Application of Free Tissue Flaps Using the Facial Artery and Vein/Retromandibular Vein as Recipient Vessels in the Repair of Postoperative Nasopharyngeal Skull Base Necrosis},
  author = {Deng, {\relax HY} and Shi, {\relax ZH} and Wang, {\relax ZY} and Ye, J and Yang, {\relax QT} and Huang, {\relax JC} and Li, {\relax WJ} and Wu, {\relax XF} and Lai, {\relax XP} and Kong, {\relax WF} and Cui, J},
  year = 2026,
  journal = {Zhonghua Er Bi Yan Hou Tou Jing Wai Ke Za Zhi},
  volume = {61},
  number = {8},
  pages = {884--890},
  doi = {10.3760/cma.j.cn115330-20260323-00169},
  abstract = {To evaluate the clinical efficacy of free tissue flap transplantation for repairing skull base defects following osteoradionecrosis after radiotherapy for nasopharyngeal carcinoma (NPC), with the facial artery and either the facial vein or retromandibular vein used as recipient vessels via a trans-submandibular, anterior masseteric, and transpterygomaxillary fissure approach. A retrospective analysis was conducted on 25 patients (18 males and 7 females, aged from 45 to 73 years) with postradiation nasopharyngeal necrosis (PRNN) between May 2024 and October 2025. The recipient artery was the facial artery in all cases. The recipient veins were the facial vein in 16 cases and the retromandibular vein in 9 cases. Flap types included the anterolateral thigh fascial flap (19 cases), forearm flap (4 cases), and anterolateral thigh flap (2 cases). During a follow-up period of 4 to 21 months, complete flap survival was observed in 24 patients, an overall flap survival rate of 96\% (24/25). One anterolateral thigh fascial adipofascial flap developed necrosis due to arterial anastomotic thrombosis. The median operation time was 836 (597, 986) min; the median intraoperative blood loss was 300 (200, 400) ml; the median postoperative hospital stay was 25 (18, 30) d; and there were no donor site complications. All flaps in the facial vein group survived (16/16), whereas 8 of 9 flaps in the retromandibular vein group survived, with no statistically significant difference (Fisher's exact test, p=0.36). Three patients died after the operation: one of intracranial infection, one of massive hemorrhage, and one of respiratory failure due to severe pneumonia.},
  keywords = {facial-vein,flap-survival,osteoradionecrosis,recipient-vessel,retromandibular-vein,skull-base}
}


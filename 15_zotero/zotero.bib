@article{chang_Microsurgery_2022,
  title = {Plate-Related Complication and Health-Related Quality of Life after Mandibular Reconstruction by Fibula Flap with Reconstruction Plate or Miniplate versus Anterolateral Thigh Flap with Reconstruction Plate},
  author = {Chang, {\relax TY} and Lai, {\relax YS} and Lin, {\relax CY} and Wang, {\relax JD} and Pan, {\relax SC} and Shieh, {\relax SJ} and Lee, {\relax JW} and Lee, {\relax YC}},
  year = 2022,
  journal = {Microsurgery},
  volume = {43},
  number = {2},
  pages = {131--141},
  doi = {10.1002/micr.30893},
  abstract = {Plate-related complications are major long-term complications in mandible reconstruction. There are controversies regarding the use of a reconstruction plate versus miniplates and a bone flap versus a soft tissue flap with a bridging plate. We retrospectively reviewed 205 patients who underwent segmental mandibulectomy and reconstruction using fibula flap with reconstruction plate (FR; n = 86), fibula flap with miniplate (FM; n = 61), and anterolateral thigh flap with reconstruction plate (AR; n = 58). The plate-related complication rate was the highest in the AR group (37.9\%), then FR (25.6\%), and lowest in FM (13.1\%; p = 0.0079). The plate exposure rate was highest in AR (24.1\%), then FR (15.7\%), lowest in FM (4.9\%; p = 0.0128). Plate fracture and dislodge rates for AR were higher than FR and FM (24.1\% vs 9.3\% vs 9.8\%; p = 0.023). The AR group had worse complication-free survival (HR 3.61, 95\% CI 1.99-6.56, p {$<$} 0.0001). Osteoradionecrosis (HR 6.19) and postoperative radiotherapy (HR 2.87) were adverse factors. Plate-related complication negatively impacted quality of life based on pain scores.},
  keywords = {bone-vs-soft-tissue,bridging-plate,comparative,osteoradionecrosis,plate-exposure,QOL}
}


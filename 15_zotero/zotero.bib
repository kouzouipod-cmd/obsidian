@article{wang_OtolaryngolHeadNeckSurg_2024,
  title = {Chimeric {{Versus Multiple Simultaneous Free Flaps}} for {{Head}} and {{Neck Reconstruction}}},
  author = {Wang, J and Tharakan, T and Jackson, {\relax RS} and Puram, {\relax SV} and Pipkorn, P},
  year = 2024,
  journal = {Otolaryngol Head Neck Surg},
  volume = {171},
  number = {6},
  pages = {1697--1704},
  doi = {10.1002/ohn.922},
  abstract = {To describe our experience with chimeric flaps and to assess the surgical outcomes and postoperative complications associated with chimeric flaps compared to multiple flaps. Patients undergoing chimeric and multiple simultaneous free tissue transfer between June 2016 and October 2023 were retrospectively reviewed. The primary outcome was complication rate. Our analysis included 113 patients (chimeric n = 38, multiple n = 75). We found no significant difference in operative times or minor complications. Chimeric flaps were associated with a shorter length of hospitalization. The major complication rate was higher for chimeric flaps (42.1\% vs 22.7\%, P = .03), but each cohort only had 1 instance of total flap loss. Our findings suggest that chimeric and multiple flaps both produce acceptable complication rates when used appropriately. Differences in complication rates may reflect differences in utilization.},
  keywords = {chimeric-flap,comparative,complications,double-flap,length-of-stay,operative-time}
}


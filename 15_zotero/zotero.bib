@article{elia_Plast.Reconstr.Surg._2026,
  title = {{Free Fibular Flap for Clavicle Reconstruction: An Orthoplastic Approach}},
  shorttitle = {{Free Fibular Flap for Clavicle Reconstruction}},
  author = {Elia, Rossella and Burger, Heinz and Sapino, Gianluca and Gonvers, Stephanie and Guillier, David and Carrozzo, Massimiliano and Giudice, Giuseppe and Di Summa, Pietro G. and Maruccia, Michele},
  year = 2026,
  month = jun,
  journal = {Plastic and Reconstructive Surgery},
  volume = {157},
  number = {6},
  pages = {895e},
  issn = {0032-1052},
  doi = {10.1097/PRS.0000000000012488},
  urldate = {2026-05-28},
  abstract = {背景：~           鎖骨再建は、特に長骨欠損の場合、再建外科医にとっていくつかの課題を伴います。本稿では、鎖骨再建における遊離腓骨皮弁の使用を評価したヨーロッパの多施設共同症例シリーズを紹介し、統一された方法で結果を報告し、整形外科的概念を適用して手術の成功率を最大化するための技術的なヒントを提案します。           方法：~           外傷、感染、または腫瘍切除による鎖骨骨欠損を有する成人患者を対象とした。手術結果は、術前および術後の上肢機能障害評価尺度（DASHスコア）およびコンスタント・マーリースコアを用いて、骨癒合と機能回復の観点から評価した。合併症発生率を記録した。患者は、1、3、6、9、および12か月後に撮影したX線写真で経過観察を行った。           結果：~           平均年齢44.4\textpm 16.4歳の患者9名が対象となった。鎖骨骨欠損の平均サイズは8.5\textpm 2.8cmであった。欠損の原因は、肉腫切除（n =5）、骨折関連感染（n =2）、放射線骨壊死（n =1）、およびガレの慢性硬化性骨髄炎（n =1）であった。平均追跡期間は32.8\textpm 13.1ヶ月であった。全例で180\textpm 20日後に骨癒合が成功した。上肢機能障害評価尺度（DASH）およびコンスタント・マーリースコアに有意な改善が認められた。90度構成の二重プレート固定やミニフラグメントプレートの使用など、整形外科的原則が適用された。           結論：~           本研究は、鎖骨の重篤な欠損を再建するための遊離腓骨皮弁の有効性を裏付けるものであり、最終的な構造の安定性を確保し、機能的転帰を最適化するための技術的戦略を強調するものである。},
  langid = {japanese},
  file = {C\:\\Users\\user\\Zotero\\storage\\DEFTTLK6\\Elia et al. - 2026 - Free Fibular Flap for Clavicle Reconstruction An Orthoplastic Approach.pdf;C\:\\Users\\user\\Zotero\\storage\\XUEJTUH3\\free_fibular_flap_for_clavicle_reconstruction__an.29.html}
}


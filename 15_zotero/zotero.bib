@article{saad_J.Reconstr.Microsurg._2012,
  title = {The {{Anatomic Basis}} of the {{Profunda Femoris Artery Perforator Flap}}: {{A New Option}} for {{Autologous Breast Reconstruction}}---{{A Cadaveric}} and {{Computer Tomography Angiogram Study}}},
  shorttitle = {The {{Anatomic Basis}} of the {{Profunda Femoris Artery Perforator Flap}}},
  author = {Saad, Adam and Sadeghi, Alireza and Allen, Robert J.},
  year = 2012,

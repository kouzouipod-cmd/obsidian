@article{vahidi_SeminPlastSurg_2020,
  title = {Osteoradionecrosis of the {{Midface}} and {{Mandible}}: {{Pathogenesis}} and {{Management}}},
  author = {Vahidi, N and Lee, {\relax TS} and Daggumati, S and Shokri, T and Wang, W and Ducic, Y},
  year = 2020,
  journal = {Semin Plast Surg},
  volume = {34},
  number = {4},
  pages = {232--244},
  doi = {10.1055/s-0040-1721759},
  abstract = {Radiation therapy is an important and commonly used treatment modality for head and neck cancers. Osteoradionecrosis (ORN) is a potential debilitating complication of treatment, which most commonly affects the mandible. Medical management is viable for mild-to-moderate ORN. More severe disease is best addressed with a combination of medical management and surgical intervention. Reconstruction with either regional vascularized flaps or vascularized osteocutaneous free flaps in case of larger full-thickness bone defects (greater than 6 cm) or anterior mandible is most appropriate. Maxillary ORN complications can present with a wide range of functional problems and facial disfigurement. Life-threatening and time-sensitive problems should be treated first, such as skull base bone coverage or correction of severe ectropion, to avoid blindness from exposure keratopathy.},
  keywords = {hyperbaric-oxygen,osteoradionecrosis,PENTOCLO,radiotherapy,review},
  file = {C:\Users\user\Zotero\storage\QAIYVKEQ\Vahidi_2020_osteoradionecrosis_midface_mandible_SeminPlastSurg.pdf}
}

@article{vanderpoorten_CurrOpinOtolaryngolHeadNeckSurg_2016,
  title = {Midface Prosthetic Rehabilitation},
  author = {Vander Poorten, V and Meulemans, J and Delaere, P},
  year = 2016,
  journal = {Curr Opin Otolaryngol Head Neck Surg},
  volume = {24},
  number = {2},
  pages = {98--109},
  doi = {10.1097/MOO.0000000000000241},
  abstract = {Midfacial defects resulting from head and neck oncological resections can be addressed by microvascular reconstructive techniques using autologous tissue. In specific indications, however, prosthetic rehabilitation can give a superior aesthetic outcome, combined with a less intensive surgical strain on the patient. In other situations, the combination of both approaches can restore much extended defects satisfactorily. This review lists the indications, technical prerequisites for success, and outcome of midface prosthetic rehabilitation. Modern three-dimensional planning techniques and three-dimensional printing of drill-guides, custom-made implants, abutments and epitheses further increase the predictability of success and the aesthetic outcome.},
  keywords = {3D-printing,obturator,prosthetic-rehabilitation,quality-of-life,review}
}

@article{vashistha_JStomatolOralMaxillofacSurg_2024,
  title = {Delayed Maxillary Reconstruction Following Mucormycosis: {{A}} Comprehensive Analysis of Surgical Strategies and Outcomes},
  author = {Vashistha, A and Goil, P and Charan Pahari, K and Garg, P},
  year = 2024,
  journal = {J Stomatol Oral Maxillofac Surg},
  volume = {126},
  number = {3},
  pages = {102067},
  doi = {10.1016/j.jormas.2024.102067},
  abstract = {This study is a prospective observational study conducted over two years from December 2020 to March 2023. To evaluate the outcomes of delayed reconstruction in patients with maxillectomy defects post-COVID-19 associated mucormycosis, focusing on safety, morbidity, and aesthetic results. Fifty patients with post-COVID-19 mucormycosis and maxillectomy defects without skin involvement were included. Reconstruction was performed after a minimum of six months post-maxillectomy. Flaps used included the radial forearm free flap (RAFF), anterolateral thigh flap (ALT), and free fibula osteomyocutaneous flap, planned using a 3D-printed model. Of the 50 patients, mean age 43 \textpm{} 8.75 years, most (88\%) were diabetic. Maxillectomy defects were categorized as type IIA, IIB, IIIA, IIIB, and IV based on the Cordeiro classification. Four flaps (8\%) required re-exploration, with three salvaged. Complications included marginal flap necrosis (4\%) and oro-nasal fistula (2\%). The average hospital stay was six days.},
  keywords = {3D-printing,Cordeiro-classification,delayed-reconstruction,flap-selection,mucormycosis}
}

@article{vollbach_Plast.Reconstr.Surg.-Glob.Open_2016,
  title = {An {{Appraisal}} of {{Internal Mammary Artery Perforators}} as {{Recipient Vessels}} in {{Microvascular Breast Reconstruction}}---{{An Analysis}} of 515 {{Consecutive Cases}}},
  author = {Vollbach, Felix H. and Heitmann, Christoph D. and Fansa, Hisham},
  year = 2016,
  month = dec,
  journal = {Plastic and Reconstructive Surgery -- Global Open},
  volume = {4},
  number = {12},
  pages = {e1144},
  doi = {10.1097/GOX.0000000000001144},
  urldate = {2025-11-01},
  abstract = {Background:~           The usage of internal mammary artery perforators (IMAPs) has been described in autologous breast reconstruction although IMAPS are not yet considered standard recipient vessels. It remains unclear if these vessels can be safely used in large flaps after radiation therapy or in delayed breast reconstruction.           Methods:~           Over a 2-year period, 515 free flaps for autologous breast reconstruction were performed on 419 patients by 2 surgeons (S1 and S2). In a retrospective analysis, time of reconstruction, ischemia time, flap weight, diameter of couplers, and complications were analyzed. All 515 flaps were compared in a subset with regard to the 2 surgeons: S1 who always used the IMA as a recipient vessel and S2 who attempted IMAP use if possible.           Results:~           Of all 515 flaps, 424 were abdominal flaps and 91 flaps were from the upper thigh. Three hundred six cases were immediate reconstructions, and 112 were delayed reconstructions. In 97 cases, implants were converted to autologous tissue. In 112 cases, the IMAPs were used; of these, 82 were immediate and 17 were delayed reconstructions, and in 13 cases, implants were removed. Thirty-five percent of all anastomoses to IMAPs had previous radiation therapy. The flap failure rate was 1.9\%. In none of these cases, the IMAPs were used. S1 never used the IMAP, and S2 used the IMAP in 37\% of all of his flaps.           Conclusions:~           IMAPs were safely used in all kinds of reconstructions and after radiation therapy, with no flap failure or negative effects on mastectomy skin flap perfusion. Using the IMAPs as recipient vessels is a further step toward simplifying microsurgical breast reconstruction.},
  langid = {american},
  file = {C\:\\Users\\user\\Zotero\\storage\\7Z94VPQP\\Vollbach et al. - 2016 - An Appraisal of Internal Mammary Artery Perforators as Recipient Vessels in Microvascular Breast Rec.pdf;C\:\\Users\\user\\Zotero\\storage\\NMZWYY4R\\an_appraisal_of_internal_mammary_artery.2.html}
}


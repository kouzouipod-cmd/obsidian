  shorttitle = {Closure of a {{Large Lumbosacral Defect}} with {{Reverse Turnover Latissimus Dorsi Muscle Flap}} and {{Bilateral Bipedicle Flap}}},
  author = {Gunenc, Ali Can and Sevim, Kamuran Zeynep and Ertas, Yunus and Albayrak, Akif and Irmak, Fatih},

@article{osawa_NeurolMedChirTokyo_2025,
  title = {One-Stage {{Surgery}} for {{Malignant Skull}} and {{Scalp Tumor}}: {{Navigation-guided Tumor Resection}} and {{Cranioplasty Using Custom-made Implants}}: {{Technical Note}}},
  shorttitle = {One-Stage {{Surgery}} for {{Malignant Skull}} and {{Scalp Tumor}}},
  author = {OSAWA, Sho and OHNO, Makoto and YANAGISAWA, Shunsuke and MIYAKITA, Yasuji and TAKAHASHI, Masamichi and FUJITA, Shohei and TSUCHIYA, Takahiro and IWATA, Shintaro and OGURA, Koichi and ARIKAWA, Masaki and AKAZAWA, Satoshi and NARITA, Yoshitaka},

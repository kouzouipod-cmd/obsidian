@article{chen_AnnPlastSurg_2020,
  title = {Use of {{Anterolateral Thigh Flap}} and {{Fibula Flap}} in {{Oncologic Maxillary Reconstruction}}: {{An Algorithm Approach}}},
  author = {Chen, {\relax SH} and Kuo, {\relax YL} and Chang, {\relax TY} and Lee, {\relax YC}},
  year = 2020,
  journal = {Ann Plast Surg},
  volume = {84},
  number = {1S Suppl 1},
  pages = {S17-S25},
  doi = {10.1097/SAP.0000000000002176},
  abstract = {Maxillary defects after oncologic resection can lead to not only cosmetic deformity but also functional problem. Reconstruction of maxillary defects remains the most challenging endeavor for plastic surgeons. An algorithm to guide plastic surgeons in selecting either the anterolateral thigh flap or the fibula flap for oncologic maxillary reconstruction has not been well established. Patients who underwent oncologic maxillectomy and free flap reconstruction from August 2012 to April 2018 were enrolled for retrospective chart review. The reconstructive plan was decided using the 4 essential components in sequence: the anterior maxillary arch, orbital floor, eyeball, and oro-sinonasal communication, which are the main considerations in the established classification systems. Accordingly, when the anterior maxillary arch was lost or when the orbital floor was lost with eyeball preservation, a fibula flap was used. Otherwise, an anterolateral thigh flap was used. Various maxillectomy defects were successfully reconstructed using an anterolateral thigh flap and a fibula flap. The proposed algorithm by using the anterolateral thigh flap and the fibula flap for oncologic maxillary reconstruction is feasible, simple, and effective.},
  keywords = {algorithm,flap-selection,maxillary-arch,maxillectomy,orbital-floor},
  file = {C:\Users\user\Zotero\storage\GWNYFGQC\Chen_2020_ALT_fibula_maxillary_algorithm_AnnPlastSurg.pdf}
}


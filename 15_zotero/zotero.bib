@article{katayama_Plast.Reconstr.Surg._2021,
  title = {{``Feasibility and Safety of Arterial Transfer for Microscopic Hepatic Artery Reconstruction After Hepatobiliary and Pancreatic Tumor Resection''}},
  author = {Katayama, Riku and Yasunaga, Yoshichika and Akazawa, Satoshi and Watarai, Aya and Haga, Yoshitaka and Araki, Jun and Nakao, Junichi and Mori, Hiroaki and Nakagawa, Masahiro and Kishi, Kazuo and Sugiura, Teiichi and Uesaka, Katsuhiko},
  year = 2021,
  month = mar,
  journal = {Plastic and Reconstructive Surgery},
  pages = {10.1097/PRS.0000000000012582},
  issn = {0032-1052},
  doi = {10.1097/PRS.0000000000012582},
  urldate = {2026-05-14},
  abstract = {背景：~           顕微鏡下肝動脈（HA）再建の選択肢には、直接吻合（DA）、動脈移植（AT）、および移植片介在（GI）がある。ATは吻合部位が1箇所で済むという利点があるものの、肝胆道腫瘍切除後のHA再建における臨床適用性および転帰については十分に検討されていない。本研究は、ATの実現可能性と安全性をDAと比較して評価することを目的とした。           方法：~           2003年から2024年の間に肝胆道腫瘍切除後に顕微鏡下肝動脈再建術を受けた患者を対象に、後向き解析を行った。実現可能性は、GIを用いずに再建に成功した症例の割合と、DA、AT、GI群における症例の分布に基づいて評価した。安全性は、AT群とDA群の間で、全体的な合併症の重症度、肝動脈血流低下に関連する潜在的な合併症の発生率、術後吻合部血栓症の発生率、および生存率を比較することによって評価した。           結果：~           130人の患者のうち、99.2\%の症例ではGIは必要なく、DA、AT、GI群はそれぞれ56\%、43\%、0.8\%を占めた。AT群とDA群の間で、全体的な合併症の重症度（p = 0.27）、HA流量低下に関連する潜在的な合併症の発生率（p = 0.50）、術後吻合部血栓症（p {$>$} 0.99）、または5年間の全生存率（29.7\% vs. 35.1\%、p = 0.37）に有意差は認められなかった。           結論：~           ATは、複雑な切除においてもDAと同等の良好な結果をもたらします。ATは、DAが実施できない場合に、顕微鏡下でのHA再建において安全かつ実行可能な選択肢であり、GIの必要性を効果的に最小限に抑えます。},
  langid = {japanese},
  file = {C\:\\Users\\user\\Zotero\\storage\\ZDT4AJMF\\Katayama et al. - 2021 - “Feasibility and Safety of Arterial Transfer for Microscopic Hepatic Artery Reconstruction After Hep.pdf;C\:\\Users\\user\\Zotero\\storage\\R7IGKQUD\\_feasibility_and_safety_of_arterial_transfer_for.2877.html}
}

